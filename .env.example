NEXT_PUBLIC_API_BASE_URL=https://api.dev.moimyeon.plady.io
NEXT_PUBLIC_DEV_ACCESS_TOKEN=
NEXT_PUBLIC_MOCK_INTERVIEW_DISCOVERY=

# PostHog: 로컬·테스트는 기본 미수집. dev 검증 시 ENABLED=true와 dev 환경을 명시한다.
# 프로젝트 설정에서 Project token과 수집 호스트(예: https://us.i.posthog.com)를 복사한다.
# 운영 배포는 ENVIRONMENT=live, 개발 배포/로컬 검증은 ENVIRONMENT=dev.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_ENVIRONMENT=dev
