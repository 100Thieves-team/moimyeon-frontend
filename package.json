{
  "name": "moimyeon-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:browser:ui": "vitest --project chromium-light --browser.headless=false",
    "test:browser:ui:dark": "vitest --project chromium-dark --browser.headless=false",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-ts",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@vanilla-extract/css": "1.21.1",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vanilla-extract/next-plugin": "2.5.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "playwright": "^1.62.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,css,scss,md,mdx,yaml,yml,toml}": "oxfmt --write"
  }
}
